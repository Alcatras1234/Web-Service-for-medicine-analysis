# Project namespace для docker compose.
# Из-за этого все наши контейнеры/сети/тома будут под группой "eosinai":
#   docker compose ps           ← покажет только наши
#   docker compose up -d        ← поднимет только наши
#   docker compose down         ← остановит и снесёт только наши
# Никакие чужие контейнеры на сервере не пострадают.
COMPOSE_PROJECT_NAME=eosinai

# ngrok authtoken (https://dashboard.ngrok.com/get-started/your-authtoken)
# Используется сервисом eosinai-ngrok для публичного туннеля наружу.
NGROK_AUTHTOKEN=3AOgmmodiTBdIAWRB1Q7N0lNDtK_5E3ekTK91ahY5K4aB7Y2M
